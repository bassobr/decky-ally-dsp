# Ally DSP: runs the speaker filter chain in its own PipeWire process, the same
# pattern Valve uses for filter-chain.service. Installed by the plugin into
# ~/.config/systemd/user/ally-dsp.service; paths are filled in at install time.
[Unit]
Description=Ally DSP speaker filter chain (Dolby tuning for the ROG Xbox Ally X)
After=pipewire.service wireplumber.service
BindsTo=pipewire.service
ConditionPathExists={conf_path}

[Service]
Type=simple
Environment="LV2_PATH={lv2_path}:/usr/lib/lv2"
Environment=MALLOC_ARENA_MAX=1
ExecStart=/usr/bin/pipewire -c "{conf_path}"
Restart=on-failure
RestartSec=1
LimitMEMLOCK=102400K
Slice=session.slice

[Install]
WantedBy=default.target
